# Copiar este archivo como .env y ajustar los valores.
# Base de datos levantada con docker-compose.yml (raíz del monorepo).
DATABASE_URL="postgresql://simep:simep@localhost:5433/simep?schema=public"

# Login con Google: Client ID de Google Cloud Console (tipo "Aplicación web").
GOOGLE_CLIENT_ID=""

# Firma de los tokens que entrega el backend. Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Primer administrador, creado con: npx prisma db seed
ADMIN_EMAIL=""
ADMIN_NOMBRE=""
ADMIN_APELLIDO=""
